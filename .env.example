# ---------------------------------------------------------------------------
# Backend — copy to .env (never commit secrets)
# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS + pgvector (docker compose up -d db)
POSTGRES_USER=flowline
POSTGRES_PASSWORD=flowline
POSTGRES_DB=flowline
DATABASE_URL=postgresql://flowline:flowline@localhost:5432/flowline
# Decision log storage: json | sqlite | postgres
DECISIONS_BACKEND=postgres

# AI agent: Google Gemini via google-genai. Leave the key empty to run without AI;
# only the briefing and chat are disabled (forecast, map and routing still work).
GEMINI_API_KEY=
# Cost-efficient stable models (ai.google.dev/gemini-api/docs/models, checked 2026-10-05):
#   gemini-3.5-flash-lite  ($0.30 in / $2.50 out per 1M tokens) — suggested
#   gemini-3.1-flash-lite  ($0.25 in / $1.50 out per 1M tokens) — cheapest
GEMINI_MODEL=gemini-3.5-flash-lite
# Budget guard: output-token cap per call and total estimated spend cap (USD).
AGENT_MAX_OUTPUT_TOKENS=800
AGENT_BUDGET_USD=15
# Optional offline fallback via local Ollama (e.g. OLLAMA_MODEL=qwen3:8b).
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434

# No key? The AI briefing and chat can use the Flowline online demo instead (3 prompts
# per visitor per day; your own GEMINI_API_KEY above always takes precedence).
# Empty = AI off without a key.
FLOWLINE_REMOTE_AI=https://flowline-api-l4sb.onrender.com

# Routing
OSRM_URL=http://localhost:5000
# Optional: Mapbox Directions fallback when OSRM is down. Needs a token that is NOT
# URL-restricted (server requests have no browser origin). Empty = straight-line fallback.
MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# Frontend — copy to .env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Mapbox public token (pk.…), URL-restricted to localhost in the Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=
# Map style: dark | light-plus | outdoors | streets (default dark)
NEXT_PUBLIC_MAP_STYLE=dark
