# Frontend (copy to .env.local — never commit secrets)
# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Mapbox public token (pk.…), URL-restricted to localhost in the Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Map style: light-plus | outdoors | streets (default light-plus)
NEXT_PUBLIC_MAP_STYLE=light-plus

# Backend (copy to .env — never commit secrets)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AGENT_MODEL=claude-haiku-4-5-20251001
