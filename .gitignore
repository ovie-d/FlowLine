# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit only the example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / local tooling
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
inspection_decisions.json
pipeline-incidents-comprehensive-data.csv
*.db

# hazard forecast — large / downloaded data and artifacts
/data/raw/
/data/osm/
/data/weather/
/data/processed/*
# Small derived public data shipped so every install matches the reference build:
# station weather per incident (ECCC, OGL-Canada) and the CER pipeline systems layer.
!/data/processed/incident_weather.csv
!/data/processed/pipelines_ca.geojson
# Model artefacts: only the small deployed model is committed (< 1 MB); anything else
# (retrains, large experiments) stays local.
/models/*
!/models/.gitkeep
!/models/hazard_forecast.lgb.txt
!/models/hazard_forecast.meta.json
!/models/hazard_forecast.eval.json
/osrm/

# agent usage logs (token counts / cost estimates)
/logs/
/.run/

# Desktop app (Electron)
desktop/node_modules/
desktop/dist/
desktop/build/flowline-home.json

# Private notes, pitch material and design review screenshots (kept locally, never committed)
private/

# Hugging Face deploy bundle (data snapshot, staged Space)
deploy/huggingface/.bundle/
